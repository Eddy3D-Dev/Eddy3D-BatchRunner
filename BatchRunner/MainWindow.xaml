<Window x:Class="BatchRunner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BatchRunner"
        xmlns:models="clr-namespace:BatchRunner.Models"
        mc:Ignorable="d"
        Title="BatchRunner"
        Icon="pack://application:,,,/assets/logo.ico"
        Height="650"
        Width="1728"
        MinHeight="520"
        MinWidth="900"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}"
                         ProgressValue="{Binding TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header / Stats -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center" ItemHeight="40">
                <Button Content="Add _Folder..." Margin="0,0,8,0" Click="AddFolder_Click"
                        ToolTip="Import a folder containing batch files to the queue (Alt+F)" />
                <Button Content="Add *._bat" Margin="0,0,16,0" Click="AddJobs_Click"
                        ToolTip="Import individual .bat files to the queue (Alt+B)" />
                
                <Button Content="_Expand All" Margin="0,0,8,0" Command="{Binding ExpandAllCommand}"
                        ToolTip="Expand all folder groups in the list (Alt+E)" />
                <Button Content="Colla_pse All" Margin="0,0,8,0" Command="{Binding CollapseAllCommand}"
                        ToolTip="Collapse all folder groups in the list (Alt+P)" />
                <Button Content="Remo_ve All" Margin="0,0,16,0" Command="{Binding RemoveAllCommand}"
                        ToolTip="Clear the entire queue (Alt+V)" />
                
                <Button Content="_Start queue" Margin="0,0,8,0" Command="{Binding StartQueueCommand}"
                        ToolTip="Begin processing the queued jobs (Alt+S)" />
                
                <Button Content="Ca_ncel Job" Margin="0,0,8,0" Command="{Binding CancelJobCommand}"
                        ToolTip="Stop the currently selected job (Alt+N)" />
                <Button Content="_Restart Job" Margin="0,0,12,0" Command="{Binding RestartJobCommand}"
                        ToolTip="Restart the selected job (or all jobs in the selected folder) (Alt+R)" Click="Button_Click" />
                
                <CheckBox Content="_Auto-retry failed jobs (1x)" Margin="0,0,12,0"
                          IsChecked="{Binding Settings.AutoRetryFailedJobs}"
                          ToolTip="Automatically retry a failed job once before marking it as failed (Alt+A)" />
                <CheckBox Content="Show _job window" Margin="0,0,16,0"
                          IsChecked="{Binding Settings.ShowConsoleWindow}"
                          ToolTip="Show the console window for running jobs (Alt+J)" />
                <CheckBox Content="Compress &amp; _Delete completed" Margin="0,0,16,0"
                          IsChecked="{Binding Settings.CompressCompletedCases}"
                          ToolTip="Compresses the completed case folder into a .zip file and deletes the original folder to save space (Alt+D)" />
                <Border Background="{StaticResource HeaderBackgroundBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,4"
                        Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Label Content="C_ores:" Target="{Binding ElementName=CoresTextBox}" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding UsedCores}" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="/" VerticalAlignment="Center" Margin="4,0" />
                        <TextBox x:Name="CoresTextBox" Text="{Binding TotalCores, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 VerticalAlignment="Center" Width="40" TextAlignment="Center"
                                 AutomationProperties.Name="Total CPU Cores"
                                 ToolTip="Maximum number of CPU cores to use for all concurrent jobs (Alt+O)" />
                        <TextBlock Text="(free: " VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding AvailableCores}" VerticalAlignment="Center" />
                        <TextBlock Text=")" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Content="V_isualise Results ↗" Margin="16,0,0,0" Click="VisualizeResults_Click"
                        ToolTip="Open the Eddy3D Visualizer in your browser (Alt+I)" />
            </WrapPanel>
        </Border>

        <!-- Folders List -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True"
                AllowDrop="True"
                Drop="FoldersList_Drop"
                DragEnter="FoldersList_DragEnter"
                DragLeave="FoldersList_DragLeave"
                DragOver="FoldersList_DragOver">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFolders, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="No jobs queued"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button Content="Add Folders..."
                                Click="AddFolder_Click"
                                Padding="24,10"
                                FontSize="14"
                                FontWeight="SemiBold"
                                ToolTip="Import folders containing batch files to the queue (Alt+F)"
                                Margin="0,0,8,0" />
                        <Button Content="Add *.bat Files"
                                Click="AddJobs_Click"
                                Padding="24,10"
                                FontSize="14"
                                FontWeight="SemiBold"
                                ToolTip="Import individual .bat files to the queue (Alt+B)" />
                    </StackPanel>
                    <TextBlock Text="Or drag and drop folders or .bat files here"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasFolders, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="FoldersListItemsControl"
                                  ItemsSource="{Binding Folders}"
                                  PreviewMouseLeftButtonDown="FoldersList_PreviewMouseLeftButtonDown"
                                  MouseMove="FoldersList_MouseMove">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:BatchFolder}">
                            <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4"
                                      HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{Binding Name, StringFormat='Folder {0}'}"
                                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceBorderBrush}">
                                <Expander.Header>
                                    <Grid Background="Transparent" Cursor="Hand">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Status -->
                                            <ColumnDefinition Width="*" /> <!-- Name -->
                                            <ColumnDefinition Width="Auto" /> <!-- Actions -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="{Binding Status}" FontWeight="Bold" Margin="0,0,10,0" Width="80"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
                                        
                                        <Button Grid.Column="2" Content="Remove" Padding="8,2" Margin="0,0,10,0"
                                                Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Name, StringFormat='Remove folder {0}'}"
                                                ToolTip="Remove this folder from the queue" />
                                    </Grid>
                                </Expander.Header>
                                <Expander.Content>
                                    <!-- Jobs DataGrid -->
                                    <DataGrid ItemsSource="{Binding Jobs}"
                                              AutoGenerateColumns="False"
                                              AlternationCount="2"
                                              BorderThickness="0"
                                              HeadersVisibility="Column"
                                              Margin="20,0,0,8"
                                              SelectedItem="{Binding DataContext.SelectedJob, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Name, StringFormat='Jobs in folder {0}'}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellTextStyle}">
                                                        <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="180"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Cores" Binding="{Binding RequiredCores}" Width="60"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Ended" Binding="{Binding EndedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}" Width="90"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Exit" Binding="{Binding ExitCode}" Width="60"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTextColumn Header="Retries" Binding="{Binding RetryCount}" Width="70"
                                                                ElementStyle="{StaticResource DataGridCellTextStyle}" />
                                            <DataGridTemplateColumn Header="Log" Width="200">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource DataGridCellTextStyle}">
                                                            <Hyperlink Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       CommandParameter="{Binding LogPath}"
                                                                       AutomationProperties.Name="{Binding LogPath, StringFormat='Open log file {0}'}"
                                                                       ToolTip="Open log file"
                                                                       Foreground="{StaticResource AccentBrush}">
                                                                <Run Text="{Binding LogFileName, Mode=OneWay}" />
                                                            </Hyperlink>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Actions" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button Content="Cancel" Margin="4,4"
                                                                    Padding="12,2"
                                                                    MinWidth="72"
                                                                    Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Cancel job {0}'}"
                                                                    ToolTip="Stop this job" />
                                                            <Button Content="Restart" Margin="4,4"
                                                                    Padding="12,2"
                                                                    MinWidth="72"
                                                                    Command="{Binding DataContext.RestartJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Restart job {0}'}"
                                                                    ToolTip="Restart this job" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander.Content>
                            </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Drag & Drop Overlay -->
                <Border x:Name="DropOverlay"
                        Background="#E6F4F6F8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        CornerRadius="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="Drop folders or .bat files here"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
